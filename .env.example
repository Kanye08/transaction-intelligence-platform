# ---------------------------------------------------------------------------
# Sycamore Transaction Intelligence Platform - development defaults
# Copy to .env (npm install / npm run setup does this automatically).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# SQLite file path is resolved relative to backend/prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Auth (npm install / npm run setup writes a random JWT_SECRET into .env)
JWT_SECRET="replace-me-npm-setup-generates-a-random-secret"
JWT_EXPIRES_IN="12h"
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Classification
# CLASSIFICATION_PROVIDER: rules | mock-llm | hybrid
# ---------------------------------------------------------------------------
CLASSIFICATION_PROVIDER=hybrid
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_REVIEW_THRESHOLD=0.6

# Mock LLM provider behaviour: normal | latency | failure | timeout | rate_limited | invalid | low_confidence
MOCK_LLM_MODE=normal
MOCK_LLM_LATENCY_MS=120
MOCK_LLM_TIMEOUT_MS=3000
MOCK_LLM_FAILURE_RATE=0

# Resilience
# 10 attempts on a 2-minute base capped at 30 minutes spans about six hours of
# provider downtime before a transaction settles as PROVISIONAL.
CLASSIFICATION_MAX_ATTEMPTS=10
CLASSIFICATION_RETRY_BASE_MS=120000
CLASSIFICATION_RETRY_MAX_MS=1800000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_MS=30000

# ---------------------------------------------------------------------------
# Background worker (in-process, database-backed queue)
# ---------------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=25

# Anomaly detection
ANOMALY_LARGE_AMOUNT_SIGMA=3
ANOMALY_MIN_SAMPLE_SIZE=20
ANOMALY_DUPLICATE_WINDOW_HOURS=24
ANOMALY_FREQUENCY_WINDOW_HOURS=24
ANOMALY_FREQUENCY_THRESHOLD=5

# Rate limiting (login endpoint)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_TTL_MS=60000
